  v37 [label="v37  +class2 加权 + 链 hinge + 更狠剪枝\n· 【class2(姐妹边)加权 3.0】\n· 【链内一致性 hinge】(方案5, margin0.3)\n· 【B2 cut 0.5→0.7】\n· v36ep79 续 → best ep90\nPerfect 19.50 / All 36.21  (+0.73pp)", fillcolor="#CFE3FF"];
  v38 [label="v38  456 改良版\n· 【class2 加权 → 2.0】\n· 【B2 cut → 0.85】(对齐推理 thr0.9)\n· 【链内边类别 CE (chain_lca_ce)】(方案6)\n· v37ep90 续 → best ep101\nPerfect 21.10 / All 37.59  (+1.60pp)\n(方案6 chain_lca_ce 才是有效的链一致性项)", fillcolor="#BBD9FF", penwidth=2.0];

  v46 [label="v46  +质量头 v1\n· 【ππ 不变质量回归】目标未归一化\n· v38 续 · best ep106\nPerfect 21.28 / All 38.22", fillcolor="#EAF3FF"];
  v47 [label="v47  ★★ 当前最优\n· v38 + 【质量头 masshead2 改良】\n· log10 归一化目标 + 掩码修复\n· v38 续 · best ep113\nPerfect 23.15 / All 39.56  (+2.05pp)\n(PhyIP 探针: 边表征质量 R² 0.003→0.93)", fillcolor="#FFD84D", color="#E0A800", penwidth=3.0];
  v48 [label="v48  三头同加 (质量+结构+动量) ~\n· Perfect 21.40 / All 37.36  vs v38 21.10 / 37.59\n· 实为“打平”(差0.23pp, 噪声内) → 旧“All 50.6% 下降”是可变分母假象", fillcolor="#FFEFC2"];

  v31 -> v32 [label="v31ep56 续 · lr→1e-4\n→ best ep61"];
