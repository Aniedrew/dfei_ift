  // ===== 优化 / 改动 参考表 (图旁) =====
  optdef [shape=plaintext, fontsize=11, label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9aa0a6">
  <TR><TD COLSPAN="3" BGCOLOR="#4477aa"><FONT COLOR="white"><B>优化 / 改动  参考表</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#eef3fb"><B>名称</B></TD><TD BGCOLOR="#eef3fb"><B>具体内容</B></TD><TD BGCOLOR="#eef3fb"><B>类别</B></TD></TR>
  <TR><TD>rebal</TD><TD>损失再平衡 (隔离 v36 配方非 PPT 项)</TD><TD>基线</TD></TR>
  <TR><TD>B2 可微剪枝</TD><TD>w_eff = w·σ((w−cut)/τ), τ 1.0→0.1 退火；模拟推理硬剪枝</TD><TD>机制</TD></TR>
  <TR><TD>b2_cut</TD><TD>B2 剪枝阈值 (0.5→0.7→0.85，逐步对齐推理 thr0.9)</TD><TD>机制</TD></TR>
  <TR><TD>class2 加权</TD><TD>LCA class2 (同母亲姐妹边) 损失加权 (3.0→2.0)</TD><TD>loss 权重</TD></TR>
  <TR><TD>chain_lca_loss (hinge)</TD><TD>链内边高置信 hinge：conf&lt;margin(0.3) 则罚 (方案5)</TD><TD>loss</TD></TR>
  <TR><TD>chain_lca_ce</TD><TD>链内边“类别正确”交叉熵 (含 hinge, 方案6) —— 真正有效的链一致性项</TD><TD>loss</TD></TR>
  <TR><TD>source head</TD><TD>源检测头 (第6头)：监督 GNN 找链根 (Rumor Centrality)</TD><TD>监督头</TD></TR>
  <TR><TD>mass head</TD><TD>边级 ππ 不变质量回归 (masshead2: log10 归一 + 掩码修复)</TD><TD>监督头 (第7)</TD></TR>
  <TR><TD>struct head</TD><TD>节点 depth + RC 双重回归</TD><TD>监督头 (第8)</TD></TR>
  <TR><TD>mom head</TD><TD>节点动量回归</TD><TD>监督头 (第9)</TD></TR>
  <TR><TD>attention</TD><TD>track 级多头自注意力；edge-bias 版用 tt 边特征作注意力 bias (ParT 式)</TD><TD>结构</TD></TR>
  <TR><TD>asym 32/24</TD><TD>tracks 节点升 32 维 / tt 边升 24 维 (其余 16)</TD><TD>结构</TD></TR>
  <TR><TD>wide GN256</TD><TD>GNblock 隐层宽度 128→256</TD><TD>结构</TD></TR>
</TABLE>>];

