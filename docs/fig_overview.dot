digraph overview {
  rankdir=TB; bgcolor="white"; compound=true; splines=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.10,0.06", penwidth=1.0, color="#9aa0a6"];
  edge [color="#9aa0a6", arrowsize=0.55, penwidth=0.9, fontname="Helvetica", fontsize=9, fontcolor="#5f6368"];
  labelloc="t";
  label=<<b>DFEI 版本家族谱 · 总览</b><br/><font point-size="11" color="#5f6368">边 = 起点关系(parent → child)　|　红色虚线边 = 失败 / 无效分支　|　数字 = PerfectReco / AllParticles（<b>修正口径</b>：CERN 固定分母 N_total=17561, thr0.9）　|　* = 公开数据线（自有分母 N=12774，跨数据集不可直接比）<br/>2026-09-13 新增：<b>oracle 上限实验（证明瓶颈=剪枝分类）</b>、联合实验 v549、固化 lr 探针 v550/v551；v519/v521 两个长训已停</font>>;
  fontsize=22; fontcolor="#202124";

