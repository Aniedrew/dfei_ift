+    def _track_associated_pv(graph):
+        """Per track, index of the PV with the smallest minIP (argmin log_minIP_reco)."""
+        store = graph[("tracks", "pvs")]
+        senders, receivers = store.edge_index[0].long(), store.edge_index[1].long()
+        ip = store.edges[:, 0]
+
+        n_tracks = graph["tracks"].x.shape[0]
+        # 修复: 补 device (原来 torch.full 建在 CPU, 数据在 GPU 时会 device mismatch)
+        best_ip = torch.full((n_tracks,), float("inf"), dtype=ip.dtype, device=ip.device)
+        best_ip.scatter_reduce_(0, senders, ip, reduce="amin", include_self=True)
+
+        is_best = ip == best_ip[senders]
+        # 修复: 没有 tr-pv 边的径迹保持 -1, 调用方必须屏蔽 (原来会静默取 zpv[-1], 是个错的 z)
+        assoc_pv = torch.full((n_tracks,), -1, dtype=torch.long, device=ip.device)
+        assoc_pv[senders[is_best]] = receivers[is_best]
+        return assoc_pv
+
+    @staticmethod
+    def _resort_tracks_tracks(graph, dz_col=DZ_COL, center=DZ_CENTER, scale=DZ_SCALE):
+        """Make p1 the track associated (by minIP) to the smaller-z PV on every tr-tr edge."""
+        store = graph[("tracks", "tracks")]
+
+        zpv = graph["pvs"].x[:, 2]
+        assoc_pv = DataSetLoader._track_associated_pv(graph)
+        # 修复: 无 tr-pv 边的径迹 (assoc_pv=-1) 必须屏蔽, 否则会静默取 zpv[-1] (错的 z)
+        valid = assoc_pv >= 0
+        track_z = torch.zeros_like(zpv[assoc_pv])
+        track_z[valid] = zpv[assoc_pv[valid]]
+
+        ei = store.edge_index.long()
+        zi, zj = track_z[ei[0]], track_z[ei[1]]
+        swap = (zi > zj) & valid[ei[0]] & valid[ei[1]]
+
+        new_ei = store.edge_index.clone()
+        new_ei[0, swap] = store.edge_index[1, swap]
+        new_ei[1, swap] = store.edge_index[0, swap]
+        store.edge_index = new_ei
+
+        # delta_z0_reco is stored normalized: undo the normalization before flipping the
+        # physical sign, then renormalize (mirrors the 'flipped' delta_z_mode below).
+        new_edges = store.edges.clone()
+        dz = new_edges[swap, dz_col]
+        denorm = -1 * (dz * scale + center)
+        new_edges[swap, dz_col] = (denorm - center) / scale
+        store.edges = new_edges
+
+        return graph
+
